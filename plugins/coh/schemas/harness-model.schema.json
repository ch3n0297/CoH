{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ch3n0297/coh/schemas/harness-model.schema.json",
  "title": "CoH Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "construction",
    "authorities",
    "routes",
    "sensors",
    "maintenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "enabled": {"type": "boolean"},
    "construction": {"$ref": "#/$defs/construction"},
    "authorities": {
      "type": "array",
      "maxItems": 2048,
      "items": {"$ref": "#/$defs/authority"}
    },
    "routes": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/route"}
    },
    "sensors": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/sensor"}
    },
    "maintenance": {"$ref": "#/$defs/maintenance"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "construction": {
            "properties": {"status": {"const": "READY"}},
            "required": ["status"]
          }
        },
        "required": ["construction"]
      },
      "then": {
        "properties": {
          "authorities": {
            "items": {
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {"enum": ["fact", "validation-declaration"]}
                    },
                    "required": ["kind"]
                  },
                  "then": {
                    "properties": {
                      "ref": {"required": ["path", "anchor_token"]}
                    }
                  }
                }
              ]
            }
          },
          "routes": {
            "minItems": 1,
            "items": {
              "properties": {
                "authorities": {
                  "properties": {
                    "agents": {"minItems": 1},
                    "guides": {"minItems": 1}
                  }
                }
              }
            }
          },
          "maintenance": {
            "properties": {
              "owner_authority_ids": {"minItems": 1},
              "triggers": {"minItems": 1}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "blockerCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "anchor_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f]+$"
        }
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blockers"],
      "properties": {
        "status": {"enum": ["READY", "BLOCKED"]},
        "blockers": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/blocker"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "READY"}},
            "required": ["status"]
          },
          "then": {"properties": {"blockers": {"maxItems": 0}}},
          "else": {"properties": {"blockers": {"minItems": 1}}}
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"$ref": "#/$defs/blockerCode"},
        "authority_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "paths": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "ref"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": [
            "agent-instructions",
            "guide",
            "fact",
            "validation-declaration"
          ]
        },
        "ref": {"$ref": "#/$defs/reference"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "agent-instructions"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {
                "properties": {
                  "path": {"pattern": "(?:^|/)AGENTS\\.md$"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"enum": ["agent-instructions", "guide"]}
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {"not": {"required": ["anchor_token"]}}
            }
          }
        }
      ]
    },
    "routeAuthorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "guides", "facts"],
      "properties": {
        "agents": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "guides": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "facts": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "explicit_tags",
        "path_prefixes",
        "authorities",
        "sensor_id",
        "evidence_policy"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "explicit_tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "path_prefixes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "authorities": {"$ref": "#/$defs/routeAuthorities"},
        "sensor_id": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "evidence_policy": {
          "enum": ["RECEIPT_REQUIRED", "NO_TRUSTED_RESULT"]
        }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "declaration_authority_id", "proof_layer"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "declaration_authority_id": {"$ref": "#/$defs/identifier"},
        "proof_layer": {
          "enum": [
            "static",
            "runtime",
            "browser",
            "live-provider",
            "production",
            "human-review"
          ]
        },
        "receipt_path": {
          "description": "Dedicated per-Sensor runtime artifact path. Dynamic validation additionally requires it to be unique, untracked, neither symlinked nor hard-linked, and disjoint from authorities and protected paths before it may be excluded from worktree scope.",
          "allOf": [
            {"$ref": "#/$defs/relativePath"},
            {"pattern": "^\\.coh/receipts/.+"}
          ]
        },
        "protected_paths": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_authority_ids", "triggers"],
      "properties": {
        "owner_authority_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "triggers": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
