{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ch3n0297/coh/schemas/build-plan.schema.json",
  "title": "CoH BuildPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "task_id_sha256",
    "repository_id",
    "base_head_sha",
    "observed_inputs",
    "model",
    "operations",
    "proof_boundaries"
  ],
  "properties": {
    "plan_version": {"const": 1},
    "task_id_sha256": {"$ref": "#/$defs/digest"},
    "repository_id": {"$ref": "#/$defs/digest"},
    "base_head_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "observed_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/observedInput"}
    },
    "model": {"$ref": "#/$defs/model"},
    "operations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/adoptOperation"},
          {"$ref": "#/$defs/createOperation"}
        ]
      }
    },
    "proof_boundaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "static",
          "runtime",
          "browser",
          "live-provider",
          "production",
          "human-review"
        ]
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!\\.git(?:/|$))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
    },
    "observedInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "state"],
          "properties": {
            "path": {"$ref": "#/$defs/relativePath"},
            "state": {"const": "ABSENT"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "state", "sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/relativePath"},
            "state": {"const": "PRESENT"},
            "sha256": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "raw_sha256", "semantic_sha256"],
      "properties": {
        "source": {"$ref": "#/$defs/relativePath"},
        "raw_sha256": {"$ref": "#/$defs/digest"},
        "semantic_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "operationBase": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "role": {"enum": ["authority", "guide", "sensor"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "expected_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "adoptOperation": {
      "allOf": [
        {"$ref": "#/$defs/operationBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "role", "mode", "path", "expected_sha256"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "role": {"enum": ["authority", "guide", "sensor"]},
            "mode": {"const": "adopt"},
            "path": {"$ref": "#/$defs/relativePath"},
            "expected_sha256": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "createOperation": {
      "allOf": [
        {"$ref": "#/$defs/operationBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "role",
            "mode",
            "path",
            "source",
            "expected_sha256",
            "permissions"
          ],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "role": {"enum": ["authority", "guide", "sensor"]},
            "mode": {"const": "create"},
            "path": {"$ref": "#/$defs/relativePath"},
            "source": {"$ref": "#/$defs/relativePath"},
            "expected_sha256": {"$ref": "#/$defs/digest"},
            "permissions": {"enum": ["file", "executable"]}
          }
        }
      ]
    }
  }
}
